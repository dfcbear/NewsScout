# ============================================================================
# NewsScout - Beispielkonfiguration (.env.example)
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
# ============================================================================

# ============================================================================
# Application & Environment
# ============================================================================
NEWSSCOUT_ENVIRONMENT=development
NEWSSCOUT_LOG_LEVEL=INFO
NEWSSCOUT_HOST=0.0.0.0
NEWSSCOUT_PORT=8000
NEWSSCOUT_TIMEZONE=Europe/Berlin

# ============================================================================
# API Credentials (PFLICHT fuer LLM-basierten Betrieb)
# ============================================================================
# Gemini API Key (Google AI Studio: https://aistudio.google.com/)
NEWSSCOUT_GEMINI_API_KEY=AIzaSyDeinEchterGeminiSchluesselHier
NEWSSCOUT_GEMINI_MODEL=gemini-3.8-flash

# ============================================================================
# Universeller LLM Provider (optional, alternativ zu Gemini)
# ============================================================================
NEWSSCOUT_LLM_PROVIDER=gemini
NEWSSCOUT_LLM_BASE_URL=http://localhost:11434/v1
NEWSSCOUT_LLM_MODEL=llama3.1:8b
NEWSSCOUT_LLM_API_KEY=
NEWSSCOUT_LLM_TEMPERATURE=0.1
NEWSSCOUT_LLM_TIMEOUT_SECONDS=45.0
NEWSSCOUT_LLM_FALLBACK_PROVIDER=openai_compatible
NEWSSCOUT_LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
NEWSSCOUT_LLM_FALLBACK_MODEL=glm-4-flash
NEWSSCOUT_LLM_FALLBACK_API_KEY=

# ============================================================================
# Telegram Bot
# ============================================================================
# Token von @BotFather erzeugen
NEWSSCOUT_TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Deine Chat-ID (z.B. 123456789)
NEWSSCOUT_TELEGRAM_CHAT_ID=987654321

# ============================================================================
# GitHub (optional - erhoeht Rate-Limit von 60 auf 5000 Req/h)
# ============================================================================
NEWSSCOUT_GITHUB_TOKEN=

# ============================================================================
# WhatsApp Bridge (WAHA) - optional
# ============================================================================
NEWSSCOUT_WHATSAPP_ENABLED=false
NEWSSCOUT_WHATSAPP_BRIDGE_URL=http://localhost:3000
NEWSSCOUT_WHATSAPP_BRIDGE_TOKEN=
NEWSSCOUT_WHATSAPP_SESSION=default
NEWSSCOUT_WHATSAPP_RECIPIENT_ID=

# ============================================================================
# Signal Bridge (signal-cli-rest-api) - optional
# ============================================================================
NEWSSCOUT_SIGNAL_ENABLED=false
NEWSSCOUT_SIGNAL_BRIDGE_URL=http://localhost:8080
NEWSSCOUT_SIGNAL_SENDER_NUMBER=
NEWSSCOUT_SIGNAL_RECIPIENT_ID=

# ============================================================================
# Web Search (Zero-Key Standard: SearXNG + DuckDuckGo)
# ============================================================================
NEWSSCOUT_SEARXNG_ENABLED=true
NEWSSCOUT_SEARXNG_BASE_URL=http://localhost:8080
NEWSSCOUT_SEARXNG_CATEGORIES=general,it
NEWSSCOUT_DUCKDUCKGO_ENABLED=true
# Optional: Kommerzielle Such-APIs
NEWSSCOUT_TAVILY_API_KEY=
NEWSSCOUT_EXA_API_KEY=

# ============================================================================
# Scheduling (Podcast-Zeiten)
# ============================================================================
NEWSSCOUT_SCHEDULE_MORNING=07:00
NEWSSCOUT_SCHEDULE_AFTERNOON=16:00
NEWSSCOUT_PIPELINE_INTERVAL_HOURS=2

# ============================================================================
# Audio (edge-tts Stimmen)
# ============================================================================
NEWSSCOUT_TTS_VOICE_MALE=de-DE-ConradNeural
NEWSSCOUT_TTS_VOICE_FEMALE=de-DE-KatjaNeural
